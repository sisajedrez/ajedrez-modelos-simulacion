{
  "name": "unvime-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "test": "node --test \"tests/env.test.js\" \"tests/failfast.test.js\" \"tests/health.test.js\" \"tests/unit/**/*.test.js\" \"tests/api/**/*.test.js\" \"tests/integration/ai.contract.test.js\"",
    "test:integration": "node --test --test-concurrency=1 \"tests/db/**/*.test.js\"",
    "test:stress": "node --test --test-concurrency=1 \"tests/stress/**/*.test.js\""
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  }
}
