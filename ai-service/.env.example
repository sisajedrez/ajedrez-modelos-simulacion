# Servicio de IA propia (puerto 8000 segun Diseno Tecnico)
HOST=127.0.0.1
PORT=8000
DATABASE_URL=postgresql://postgres@127.0.0.1:5434/ajedrez_db
# false => /health no consulta la base (util para desarrollar sin PostgreSQL)
DB_ENABLED=true
DB_CONNECT_TIMEOUT=2

# La red entrenada se guarda y se carga como MODELS_DIR/policy_net.npz
MODELS_DIR=./models
# Si la probabilidad que la red pone sobre jugadas legales es menor a este umbral, se usa la tabla de
# aperturas y, si tampoco hay, se responde source="none" (el Backend respalda con Stockfish)
MIN_LEGAL_PROB=0.05

# Seed por defecto (PGN de Lichess)
SEED_PGN_PATH=./data/datasetchess.pgn
SEED_MAX_GAMES=5000

# Entrenamiento offline desde CSV (python -m training.train_csv)
TRAIN_CSV_PATH=./data/datasetchess.csv
TRAIN_MAX_ROWS_PER_LEVEL=100000
TRAIN_MIN_ROWS=200
TRAIN_CHUNK_SIZE=500000

# Reentrenamiento desde la base (POST /model/train)
DB_TRAIN_MAX_ROWS_PER_LEVEL=150000

# Red neuronal
NN_HIDDEN=512,512
NN_EPOCHS=8
NN_BATCH_SIZE=512
NN_LR=0.001
NN_FINETUNE_EPOCHS=3
NN_FINETUNE_LR=0.0003
